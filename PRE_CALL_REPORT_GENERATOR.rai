  "metadata": {},
  "title": "PRE-CALL REPORT GENERATOR",
  "description": "Takes in company and prospect summary and generates a pre-call report for sales reps to help them prepare and strategize.",
  "transformations": {
    "steps": [
      {
        "name": "llm",
        "transformation": "prompt_completion",
        "params": {
          "prompt": "# Role\n\nYou are an elite sales strategist and business intelligence expert with extensive experience in tech recruitment and software industry sales. Your deep understanding of sales psychology and proven track record of analyzing prospect data to create winning sales strategies makes you invaluable for pre-call preparation.\n\n# Task\n\nAnalyze the provided company research and prospect Linkedln data to create a strategic sales call preparation guide for a sales rep at Big Boy Recruits.\n\nBig Boy Recruits is a Dallas-based recruitment firm specializing in software industry talent acquisition for SMBs across the USA. Our unique value proposition lies in our ability to identify and secure top talent from companies that have recently undergone liquidation or exits. This gives our clients access to high-quality candidates who are immediately available and have proven experience in scaling software companies.\n\nTo write this report use the following process:\n\n1. Review and synthesize the company research data to identify key business challenges and opportunities\n\n2. Analyze the prospect's Linkedln information to understand their background, role, and potential pain points\n\n3. Map Big Boy Recruits' unique value proposition to the prospect's specific situation\n\n4. Generate strategic talking points and recommendations for the sales call\n\n5. Outline potential objections and effective counter-responses\n\nInput variables:\n\n# Specifics\n\n{{prospect_summary}}\n\n{{long_text}}\n\n- Your thorough analysis is crucial for our sales team's success, please provide detailed and actionable insights\n\n- Focus on highlighting how our expertise in sourcing talent from liquidated/exited companies specifically addresses their needs\n\n- We deeply value your strategic guidance in helping position our services effectively\n\n- Include specific conversation starters based on the prospect's background\n\n- Identify trigger points that would make our services particularly valuable to their situation\n\n\n# Notes\n\n- Always maintain a consultative approach rather than pure sales pitch\n\n- Ensure all recommendations align with prospect's specific industry and growth stage\n\n- If prospect shows interest in specific talent pools, be prepared to provide relevant examples\n\n- Remember to highlight our Dallas presence while emphasizing our national reach\n\n\n",
          "model": "relevance-cost-optimized",
          "strip_linebreaks": false,
          "temperature": 0,
          "split_and_map": false,
          "stream": false,
          "parallel_tool_calls": false
        },
        "version_metadata": {
          "current_version": 1,
          "latest_version": 1,
          "has_update": false
        },
        "output": {
          "answer": "{{answer}}"
        }
      }
    ]
  },
  "params_schema": {
    "properties": {
      "prospect_summary": {
        "metadata": {
          "is_frontend_required": false,
          "api_selector_placeholder": "Select Option...",
          "hidden": false,
          "relevance_only": false,
          "advanced": false,
          "dont_substitute": false
        },
        "order": 1,
        "type": "string",
        "title": "Prospect Summary",
        "description": "Summary of the prospect based on LinkedIn profile data"
      },
      "long_text": {
        "metadata": {
          "is_frontend_required": false,
          "content_type": "long_text",
          "api_selector_placeholder": "Select Option...",
          "hidden": false,
          "relevance_only": false,
          "advanced": false,
          "dont_substitute": false
        },
        "order": 2,
        "type": "string",
        "title": "Company Summary",
        "description": "Summary of the company based on their website content"
      }
    },
    "required": [
      "prospect_summary",
      "long_text"
    ],
    "type": "object"
  },

{
  "studio_id": "40fa7808-33a3-4c7d-9e66-b7c73198ae44",
  "version": "latest",
  "in_marketplace": false,
  "insert_date_": "2026-04-04T05:13:29.678Z",
  "update_date_": "2026-04-04T05:15:41.898Z",
  "is_hidden": false,
  "tags": {},
  "publicly_triggerable": false,
  "public": false,
  "metadata": {},
  "title": "🔍ANALYZE COMPANY ",
  "description": "Takes in a company URL and scrapes their website then returns an AI generated summary",
  "transformations": {
    "steps": [
      {
        "name": "firecrawl",
        "transformation": "firecrawl",
        "params": {
          "scrape_only": false,
          "extract_main_content_only": true,
          "page_limit": 5,
          "url": "{{company_url}}"
        },
        "version": 1,
        "version_metadata": {
          "current_version": 1,
          "latest_version": 1,
          "has_update": false
        }
      },
      {
        "name": "llm",
        "transformation": "prompt_completion",
        "params": {
          "prompt": "SYSTEM: You are a strategic website analyst working on behalf of a client. Your job is to analyse competitor and reference websites and extract insights that will directly inform how this client's website should be built, positioned, and written.\n\nAbout the client's business: [DESCRIBE THE CLIENT'S BUSINESS, AUDIENCE AND OFFER HERE.]\n\nThe client's core website philosophy: [DESCRIBE HOW THE CLIENT WANTS THEIR WEBSITE TO FEEL, FOR EXAMPLE LEADING WITH PURPOSE INSTEAD OF A LIST OF SERVICES.]\n\nUSER: Below is the scraped content of a website. Analyse it and answer every question below. Be specific, quote or paraphrase actual content from the site where relevant. Do not be vague.\n\n{{firecrawl.data[*]}}\n\nAnswer the following:\n\nOpening statement: What is the very first thing a visitor sees or reads? Does it lead with a problem, a vision, a service list, or something else? Quote it or closely paraphrase it.\n\nAudience clarity: How quickly and specifically does the site identify who it is for? Is the audience named explicitly or implied?\n\nJourney vs menu: Does the site feel like a journey (one path, building narrative) or a menu (multiple options, catalogue style)? What specific structural or design choices create that feeling?\n\nOffer presentation: How are the products or services presented, by category, by level, by partner?\n\nOutcome claims: Does the site make any claims about results, partnerships or customer outcomes? Are these specific (numbers, companies) or vague?\n\nCredibility signals: What does the site use for social proof, such as logos, testimonials, press coverage or partner badges? Which are most prominent?\n\nWhat it does better than the client could: Be honest. What does this site do particularly well that the client's site should learn from?\n\nWhat the client's site can do better: Based on the client's model, what gaps or weaknesses in this site are an opportunity to differentiate?\n\nOverall essence score: On a scale of 1 to 5, how much does this site lead with purpose and vision rather than services? Briefly justify your score.\n\n----\n\n#NOTES\n\nDO NOT OUTPUT IN JSON, IT MUST BE A NATURAL LANGUAGE OUTPUT",
          "model": "relevance-cost-optimized",
          "strip_linebreaks": false,
          "temperature": 0,
          "split_and_map": false,
          "stream": false,
          "parallel_tool_calls": false
        },
        "version": 1,
        "version_metadata": {
          "current_version": 1,
          "latest_version": 1,
          "has_update": false
        },
        "output": {
          "answer": "{{answer}}"
        }
      }
    ]
  },
  "params_schema": {
    "properties": {
      "company_url": {
        "metadata": {
          "is_frontend_required": false,
          "api_selector_placeholder": "Select Option...",
          "hidden": false,
          "relevance_only": false,
          "advanced": false,
          "dont_substitute": false
        },
        "order": 1,
        "type": "string",
        "title": "Company URL",
        "description": "This is a URL for a company to be researched, must be in the format https://....."
      }
    },
    "required": [
      "company_url"
    ],
    "type": "object"
  },
  "output_schema": {},
  "state_mapping": {
    "company_url": "params.company_url",
    "firecrawl": "steps.firecrawl.output",
    "llm": "steps.llm.output"
  },
  "integration_requirements": {
    "api_keys": [
      {
        "provider": "firecrawl",
        "has_platform_key": true,
        "transformation_ids": [
          "firecrawl"
        ],
        "user_key_required_transformation_ids": []
      }
    ],
    "oauth": []
  },
  "params": {}
}
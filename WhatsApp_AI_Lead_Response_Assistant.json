    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst message = body.messages ? body.messages[0] : body;\n\nif (!message || message.from_me === true || !message.text || !message.text.body) {\n  return [];\n}\n\n// Ignore group messages entirely, groups are never real gym leads.\n// Individual chat IDs end in @s.whatsapp.net, group IDs end in @g.us\nif (message.chat_id && message.chat_id.includes('@g.us')) {\n  return [];\n}\n\n// Deduplicate by message id, some providers deliver the same message twice,\n// once on receipt, once on a status update. Skip anything already seen recently.\nconst msgId = message.id || message.message_id || '';\nif (msgId) {\n  const staticData = $getWorkflowStaticData('node');\n  if (!staticData.seenIds) staticData.seenIds = [];\n  if (staticData.seenIds.includes(msgId)) {\n    return [];\n  }\n  staticData.seenIds.push(msgId);\n  if (staticData.seenIds.length > 100) {\n    staticData.seenIds = staticData.seenIds.slice(-100);\n  }\n}\n\nreturn [{\n  json: {\n    sender_number: message.from || message.chat_id || '',\n    message_text: message.text.body,\n    timestamp: new Date().toISOString(),\n    sender_name: message.from_name || ''\n  }\n}];"
      },

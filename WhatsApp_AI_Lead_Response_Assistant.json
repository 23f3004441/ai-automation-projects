    {
      "parameters": {
        "jsCode": "const variants = [\n  \"Let me get someone from the team to help you with that, they'll reach out shortly!\",\n  \"Good question! I'll have someone from our team get in touch with you shortly for that.\",\n  \"I'll connect you with our team for this, they'll reach out soon!\"\n];\nconst replyText = variants[Math.floor(Math.random() * variants.length)];\nconst priorHistory = $(\"Get History\").item.json[\"Conversation History\"] || \"\";\nconst newHistory = (priorHistory ? priorHistory + \"\\n\" : \"\") + \"Lead: \" + $(\"Extract Message\").item.json.message_text + \"\\nBot: \" + replyText;\nreturn [{\n  json: {\n    reply_text: replyText,\n    needs_followup: true,\n    conversation_history: newHistory,\n    whapi_body: JSON.stringify({\n      to: $(\"Extract Message\").item.json.sender_number,\n      body: replyText\n    })\n  }\n}];"
      },

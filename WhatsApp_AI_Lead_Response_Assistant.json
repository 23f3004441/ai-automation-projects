        "jsCode": "const replyText = $json.choices[0].message.content;\nconst priorHistory = $('Get History').item.json['Conversation History'] || '';\nconst newHistory = (priorHistory ? priorHistory + '\\n' : '') + 'Lead: ' + $('Extract Message').item.json.message_text + '\\nBot: ' + replyText;\nreturn [{\n  json: {\n    reply_text: replyText,\n    needs_followup: false,\n    conversation_history: newHistory,\n    whapi_body: JSON.stringify({\n      to: $('Extract Message').item.json.sender_number,\n      body: replyText\n    })\n  }\n}];"
